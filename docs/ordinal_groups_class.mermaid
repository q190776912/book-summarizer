classDiagram
    %% ============ 新配置 Schema：ordinal 分组数组 ============
    class GroupConfig {
        +int type
        +List~str~ name
        +int depth
        +int scope
        +structure() Optional~str~
        +language() str
        +prefix_len() int
        +is_uncat() bool
    }

    class BookConfig {
        +List~GroupConfig~ ordinal
        +str language
        +bool strict
        +List~str~ ignore
        +Optional~str~ manual
        +List~int~ section_types
        +List~int~ section_depths
        +primary_type() int
        +extractor_family() str
        +match_group(canon_label) GroupConfig
        +uncat_group() GroupConfig
        +has_cn_three_level() bool
    }

    class ConfigLoader {
        +book_config_path
        +bool book_config_has_ordinal
        +BookConfig book
        +_load_book_config() BookConfig
        +require_complete(allow_absent) void
    }

    class ConfigError {
    }

    class ExtractLayer {
        +run(ctx)
    }
    class BLayer {
        +_md_gap_blocking(ctx)
    }
    class ExtractItems {
        +extract_items(ext, ch, start, end, manual, groups)
    }
    class ExtractBLayer {
        +_group_key(it, groups)
        +recover_missing_items(...)
    }
    class KeyParse {
        +keys_in_md(path, groups, chapter_roman)
    }
    class MakeConfig {
        +main()
        +detect_ordinal(ext) int
    }

    %% ---- 关系 ----
    BookConfig "1" *-- "1..*" GroupConfig : ordinal 数组
    ConfigLoader ..> BookConfig : 构造(from_dict)
    ConfigLoader ..> ConfigError : raise(旧格式/缺 ordinal)
    ConfigLoader --> BookConfig : book

    ExtractLayer ..> BookConfig : ctx.config
    ExtractLayer ..> ExtractItems : groups=cfg.ordinal
    ExtractLayer ..> KeyParse : keys_in_md(groups)

    BLayer ..> BookConfig : ctx.config
    BLayer ..> GroupConfig : match_group(label)

    ExtractItems ..> ExtractBLayer : recover_missing_items(groups)
    ExtractBLayer ..> GroupConfig : match_group(label)

    MakeConfig ..> BookConfig : 写出 groups 数组
    MakeConfig ..> ConfigLoader : 同 ConfigLoader 读取

    %% ---- 删除项（标注，不建模为类）----
    note for BookConfig "删除: separate_types 字段\n删除: BookConfig.depth 派生属性\n删除: group_prefix_len()\n删除: SEP_COMBINED / SEP_PER_TYPE 常量"
    note for GroupConfig "type: ORDINAL_* 1..7\nname: 标签类别(含 uncat 兜底)\ndepth: 该组段数(取代旧派生 depth)\nscope: 1=book/2=chapter/3=section"
